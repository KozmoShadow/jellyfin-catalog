# Copia questo file in ".env" e inserisci i tuoi valori reali.
# Il file .env NON deve essere committato (è già in .gitignore).

TMDB_API_KEY=la_tua_chiave_tmdb
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=la_tua_chiave_jellyfin

# Cartelle in cui viene salvato il catalogo (opzionali).
# Se non le imposti, si usano le cartelle "Serie", "Film" e "Anime" dentro il progetto.
SERIES_PATH=C:/percorso/verso/Serie
FILMS_PATH=C:/percorso/verso/Film
ANIME_PATH=C:/percorso/verso/Anime
